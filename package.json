{
  "name": "@aduverger/pi-ship",
  "version": "0.1.2",
  "description": "Workspace-aware simplify, review, and GitHub pull request workflow for Pi.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aduverger/pi-ship.git"
  },
  "homepage": "https://github.com/aduverger/pi-ship#readme",
  "bugs": {
    "url": "https://github.com/aduverger/pi-ship/issues"
  },
  "type": "module",
  "license": "MIT",
  "author": "Alexandre Duverger",
  "keywords": [
    "pi-package",
    "pi-extension",
    "code-review",
    "github",
    "pull-request",
    "workspace"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "NOTICE.md",
    "scripts/verify-package.mjs",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^24.10.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:package": "node scripts/verify-package.mjs",
    "pack:check": "npm_config_cache=.npm-cache npm pack --dry-run && npm run verify:package",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:package",
    "prepack": "npm run check"
  }
}
