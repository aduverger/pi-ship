{
  "name": "@aduverger/pi-ship",
  "version": "0.1.0",
  "description": "Workspace-aware simplify, review, and GitHub pull request workflow for Pi.",
  "type": "module",
  "license": "MIT",
  "author": "Alexandre Duverger",
  "keywords": [
    "pi-package",
    "pi-extension",
    "code-review",
    "github",
    "pull-request",
    "workspace"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^24.10.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run check"
  }
}
